{
  "schema_version": "1.0",
  "workspace_id": "{{DECK_NAME}}",
  "deck_name": "{{DECK_NAME}}",
  "profile": "template-edit",
  "paths": {
    "plan": "per-slide-content-plan.md",
    "outline": "outline.json",
    "design_brief": "design-brief.json",
    "design_contract": "design-contract.json",
    "font_contract": "font-contract.json",
    "evidence_plan": "evidence-plan.json",
    "asset_plan": "asset-plan.json",
    "font_audit": "build/font-audit.json",
    "build_report": "build/build-report.json",
    "render_manifest": "renders/final/manifest.json",
    "visual_review": "reviews/visual-review-final.json"
  },
  "renderer": {
    "kind": "pptxgenjs",
    "entrypoint": "src/deck.js"
  },
  "tool_policy": {
    "officecli_adapter_reference": "references/officecli-adapter.md",
    "allow_routable_officecli_skill": false
  }
}
