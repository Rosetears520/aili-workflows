{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/design-contract.schema.json",
  "title": "PPTX executable design contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slide_size", "content_area", "typography_roles", "palette_roles", "shape_language", "image_treatment", "chart_table_treatment", "navigation_footer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "slide_size": {"type": "string", "minLength": 1},
    "content_area": {"type": "object"},
    "typography_roles": {"type": "object"},
    "palette_roles": {"type": "object"},
    "shape_language": {"type": "object"},
    "image_treatment": {"type": "object"},
    "chart_table_treatment": {"type": "object"},
    "navigation_footer": {"type": "object"}
  }
}
