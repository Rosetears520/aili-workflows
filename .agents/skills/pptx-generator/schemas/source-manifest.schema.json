{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/source-manifest.schema.json",
  "title": "PPTX source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "required", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["content", "data", "controlling-template", "inspect-input", "brand", "citation"]},
          "path": {"type": "string"},
          "required": {"type": "boolean"},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
