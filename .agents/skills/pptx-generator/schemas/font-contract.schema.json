{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/font-contract.schema.json",
  "title": "PPTX font requirements and environment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_basis", "fonts", "environments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selection_basis": {"type": "string", "minLength": 1},
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "family", "required", "fallback_allowed"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "fallback_allowed": {"type": "boolean"},
          "approved_fallbacks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "render", "target"],
      "properties": {
        "build": {"$ref": "#/$defs/environment"},
        "render": {"$ref": "#/$defs/environment"},
        "target": {"$ref": "#/$defs/environment"}
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "available_fonts", "evidence"],
      "properties": {
        "status": {"enum": ["verified", "unverified"]},
        "available_fonts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "observed_substitutions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
